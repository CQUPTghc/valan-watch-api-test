# 仅填写隔离测试环境；不要提交真实账号、密码或 Token。
BASE_URL=https://your-test-api.example.com
VALAN_PHONE=
VALAN_PASSWORD=
VALAN_NONEXISTENT_PHONE=

# 可选：设备正向查询。IMEI 和设备 ID 必须属于隔离测试设备。
VALAN_TEST_DEVICE_IMEI=
VALAN_TEST_DEVICE_ID=

# 可选：仅用于家人账号查找；关系写入仍需人工或隔离环境。
VALAN_FAMILY_TEST_PHONE=

# 可选：版本检查；默认 ANDROID / 1。
VALAN_APP_VERSION_CHANNEL=ANDROID
VALAN_APP_CURRENT_BUILD=1
